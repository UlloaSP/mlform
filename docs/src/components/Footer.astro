---
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default />
<div class="brand-footer">
  <span>MLForm is part of <a href="https://eshkra.dev">eshkra</a>, open-source tools for models people can use.</span>
  <span class="links">
    <a href="https://github.com/UlloaSP/mlform">GitHub</a>
    <a href="https://www.npmjs.com/package/mlform">npm</a>
    <a href="https://github.com/UlloaSP/mlform/blob/main/LICENSE">MIT license</a>
  </span>
</div>

<style>
  .brand-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--mf-border);
    color: var(--mf-text-3);
    font-size: 0.8125rem;
  }
  .links {
    display: inline-flex;
    gap: 1.25rem;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--mf-ember-ink);
  }
</style>

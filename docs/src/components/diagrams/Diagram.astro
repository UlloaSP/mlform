---
interface Props {
  /** Unique within a page; prefixes the title, description, and arrow marker ids. */
  id: string;
  title: string;
  description: string;
  viewBox: string;
  caption?: string;
  /** Width below which the diagram scrolls horizontally instead of shrinking its text. */
  minWidth?: string;
}
const { id, title, description, viewBox, caption, minWidth = "34rem" } = Astro.props;
---

<figure class="diagram not-content" style={`--diagram-min: ${minWidth}`}>
  <div class="diagram-scroll" tabindex="0" role="region" aria-label={`${title}, scrollable`}>
    <svg {viewBox} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
      <title id={`${id}-title`}>{title}</title>
      <desc id={`${id}-desc`}>{description}</desc>
      <defs>
        <marker id={`${id}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path class="arrow-head" d="M0 0 L10 5 L0 10 z"></path>
        </marker>
        <marker id={`${id}-aa`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path class="arrow-head-accent" d="M0 0 L10 5 L0 10 z"></path>
        </marker>
      </defs>
      <slot />
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

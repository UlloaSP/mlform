---
const variants = [
  ["stacked", "Stacked", "The default: every field, then every report.", "mountForm(host, { schema, transport })"],
  ["split", "Split", "Reports beside the inputs on wide screens.", 'layout: { kind: "split" }'],
  ["wizard", "Wizard", "Next validates the current step before moving on.", 'layout: { kind: "wizard", steps }'],
  ["tabs", "Tabs", "Free switching; submission from any tab.", 'layout: { kind: "tabs", tabs }'],
  ["sections", "Sections", "Collapsible sections; Assessment starts closed.", 'layout: { kind: "stacked", children: [section, section] }'],
  ["custom", "Custom shell", "Your own navigation and footer around MLForm's controls.", "createFormView + createPrimitiveAdapter"],
] as const;
---

<p>
  Every form below uses the same schema and the same demo transport, and they run independently:
  fill one in and press its submit button to see validation, loading, and the classifier report. The
  configuration for each layout is explained in <a href="/view/layouts/">Layouts</a>; the custom shell
  is described in <a href="/kit/primitive-adapter/">Built-in controls in your layout</a>.
</p>

<div class="showcase not-content" data-layout-showcase>
  {
    variants.map(([id, title, body, code]) => (
      <section class="showcase-card" aria-labelledby={`showcase-${id}`}>
        <header>
          <h2 id={`showcase-${id}`}>{title}</h2>
          <p>{body}</p>
          <code>{code}</code>
        </header>
        <div class="showcase-host" data-layout-showcase-host={id} />
      </section>
    ))
  }
</div>

<script>
  import "../lib/layout-showcase-entry";
</script>

<style is:global>
  .showcase {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .showcase-card {
    display: grid;
    gap: 1rem;
    padding: clamp(0.75rem, 2.5vw, 1.25rem);
    border: 1px solid var(--mf-border);
    border-radius: 14px;
    background: var(--mf-subtle);
  }
  .showcase-card header {
    display: grid;
    gap: 0.25rem;
  }
  .showcase-card h2 {
    margin: 0;
    font-size: 1.125rem;
  }
  .showcase-card p {
    margin: 0;
    color: var(--mf-text-2);
    font-size: 0.9rem;
  }
  .showcase-card code {
    justify-self: start;
    color: var(--mf-ember-ink);
    font-size: 0.8rem;
  }
  .custom-shell {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem;
    font-family: var(--brand-font-sans);
  }
  .custom-nav {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .custom-nav button,
  .custom-submit {
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--mf-border-strong);
    border-radius: 999px;
    background: var(--mf-bg);
    color: var(--mf-text);
    font: 600 0.875rem var(--brand-font-sans);
    text-align: start;
    cursor: pointer;
  }
  .custom-nav button[aria-current="true"] {
    border-color: var(--mf-ember);
    background: var(--mf-ember-soft);
    color: var(--mf-ember-ink);
  }
  .custom-main,
  .custom-slots {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }
  .custom-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }
  .custom-status {
    color: var(--mf-text-3);
    font-size: 0.875rem;
  }
  .custom-submit {
    border-color: transparent;
    background: var(--mf-text);
    color: var(--mf-bg);
  }
  .custom-submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  @media (max-width: 40rem) {
    .custom-shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .custom-nav {
      grid-auto-flow: column;
      justify-content: start;
    }
  }
</style>

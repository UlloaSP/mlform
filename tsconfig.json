{
  "compilerOptions": {
    // Language and module settings
    "target": "ES2024",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,

    // Output and build
    "outDir": "dist/types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "sourceMap": true,
    "incremental": true,

    // Type checking and strictness
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Decorators and class fields
    "experimentalDecorators": true,
    "useDefineForClassFields": true,

    // Path aliases
    "paths": {
      "@/*": ["./src/*"],
      "mlform": ["./src/kit/index.ts"],
      "mlform/kit": ["./src/kit/index.ts"],
      "mlform/view": ["./src/view/index.ts"],
      "mlform/runtime": ["./src/runtime/index.ts"],
      "mlform/schema": ["./src/schema/index.ts"],
      "mlform/builtins": ["./src/builtins/index.ts"],
      "mlform/transport": ["./src/transport/index.ts"],
      "mlform/primitives": ["./src/primitives/index.ts"],
      "mlform/design": ["./src/design/index.ts"]
    },

    // Type definitions
    "types": ["vite/client"]
  },
  // Project file includes
  "include": ["src/**/*.ts", "test/**/*.ts"]
}

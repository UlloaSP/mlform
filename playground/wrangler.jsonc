{
  "name": "mlform-playground",
  "main": "worker.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "playground.mlform.eshkra.dev", "custom_domain": true }],
}

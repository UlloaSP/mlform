{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "types": ["vite/client", "node"],
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "incremental": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "server/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "*.ts"]
}

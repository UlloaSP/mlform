---
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import { marks } from "../data/captures";
import { links } from "../data/site";

// Bento order: stacked beside wizard and tabs, split across the full width underneath.
const layouts = [
  {
    kind: "stacked",
    note: "Everything on one page.",
    alt: "Stacked layout: measurements and results sections on one page with a submit footer.",
    sizes: "(max-width: 56rem) 92vw, 41rem",
  },
  {
    kind: "wizard",
    note: "Each step validates before the next.",
    alt: "Wizard layout on step 2 of 3, Measurements, with Previous and Next buttons.",
    sizes: "(max-width: 56rem) 92vw, 34rem",
  },
  {
    kind: "tabs",
    note: "Move freely between tabs.",
    alt: "Tabs layout with Measurements, Location and Results tabs.",
    sizes: "(max-width: 56rem) 92vw, 34rem",
  },
  {
    kind: "split",
    note: "Inputs left, reports right.",
    alt: "Split layout: inputs in the left column and the two reports in the right column.",
    sizes: "(max-width: 56rem) 92vw, 76rem",
  },
];
const legend = [
  { code: '{ kind: "group", columns: 2 }', note: "Two columns" },
  { code: '{ kind: "group", columns: 3 }', note: "Three columns" },
  { code: '{ kind: "section", defaultOpen: false }', note: "Starts collapsed" },
];
---

<section class="section layouts" id="layouts" aria-labelledby="layouts-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="layouts-title">Four layouts. One schema.</h2>
      <p>
        Change <code class="mono">layout.kind</code>. Fields, validation and reports stay exactly
        the same.
      </p>
      <a class="text-link" href={links.layouts}>
        Layout schema <Icon name="arrow-up-right" size={14} />
      </a>
    </header>
    <ul class="layout-grid">
      {layouts.map(({ kind, note, alt, sizes }) => (
        <li class={`window layout-${kind}`}>
          <div class="window-bar">
            <code class="mono">kind: "{kind}"</code>
            <span>{note}</span>
          </div>
          <Shot name={`layout-${kind}`} title={`${kind} layout`} alt={alt} sizes={sizes} />
        </li>
      ))}
    </ul>

    <div class="compose">
      <div class="compose-copy">
        <h3>Group fields. Collapse sections.</h3>
        <p>
          Groups place fields in one, two or three columns. Sections fold away. Both nest inside any
          layout, including wizard steps and tabs.
        </p>
        <ol class="legend">
          {legend.map(({ code, note }, index) => (
            <li>
              <span class="marker mono" aria-hidden="true">
                {index + 1}
              </span>
              <span>
                <code class="mono">{code}</code>
                <small>{note}</small>
              </span>
            </li>
          ))}
        </ol>
      </div>
      <div class="window">
        <Shot
          name="sections"
          title="Groups and sections"
          alt="A form with a Station section in two columns, a Measurements section in three columns and a collapsed Maintenance section."
          sizes="(max-width: 64rem) 92vw, 46rem"
          marks={marks("sections", ["1", "2", "3"])}
        />
      </div>
    </div>
  </div>
</section>

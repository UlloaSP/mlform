---
import { Image, getImage } from "astro:assets";
import mark from "../../../brand/mlform.png";
import Icon from "../components/Icon.astro";
import Wordmark from "../components/Wordmark.astro";
import { description as defaultDescription, links } from "../data/site";
import "../../../brand/typography.css";
import "../styles/base.css";
import "../styles/chrome.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "MLForm · Interfaces for machine-learning models",
  description = defaultDescription,
  noindex = false,
} = Astro.props;
const favicon = await getImage({ src: mark, width: 48, format: "png" });
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "MLForm",
  description,
  url: links.home,
  codeRepository: links.github,
  programmingLanguage: "TypeScript",
  license: "https://opensource.org/license/mit",
  author: { "@type": "Person", name: "Pablo Ulloa Santín", url: "https://github.com/UlloaSP" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MLForm" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="MLForm: give your model an interface. A real weather-station form rendered with the eshkra theme."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="nav">
      <div class="nav-inner wrap">
        <a class="mlform-brand" href="/" aria-label="MLForm home">
          <Image src={mark} alt="" width={36} height={40} densities={[1, 2]} loading="eager" />
          <Wordmark />
        </a>
        <a class="parent-brand" href={links.eshkra}>
          by eshkra
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a class="nav-section" href="/#inputs">
            Inputs
          </a>
          <a class="nav-section" href="/#layouts">
            Layouts
          </a>
          <a class="nav-section" href="/#plugins">
            Plugins
          </a>
          <a class="nav-section" href="/#backends">
            Backends
          </a>
          <a class="nav-docs" href={links.docs}>
            Docs
          </a>
        </nav>
        <div class="nav-actions">
          <a class="icon-link" href={links.github} aria-label="MLForm on GitHub">
            <Icon name="github" size={20} />
          </a>
          <a class="button small" href={links.playground}>
            Playground <Icon name="arrow-up-right" size={14} />
          </a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner wrap">
        <div class="footer-brand">
          <a class="mlform-brand" href="/" aria-label="MLForm home">
            <Image src={mark} alt="" width={64} height={72} densities={[1, 2]} />
            <Wordmark />
          </a>
          <p>
            Part of <a href={links.eshkra}>eshkra</a>.<br />
            Open-source tools for models people can use.
          </p>
        </div>
        <nav aria-label="Build">
          <h2>Build</h2>
          <a href={links.quickStart}>Quick start</a>
          <a href={links.docs}>Documentation</a>
          <a href={links.api}>API reference</a>
          <a href={links.playground}>Playground</a>
        </nav>
        <nav aria-label="Project">
          <h2>Project</h2>
          <a href={links.npm}>npm</a>
          <a href={links.github}>GitHub</a>
          <a href={`${links.github}/issues`}>Issues</a>
          <a href={`${links.github}/blob/main/LICENSE`}>MIT license</a>
        </nav>
      </div>
      <div class="footer-bottom wrap">
        <span>© {new Date().getFullYear()} eshkra</span>
        <a href={links.eshkra}>
          Explore the family <span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
  </body>
</html>
